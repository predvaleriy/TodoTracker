@page
@model IndexModel
@{
    ViewData["Title"] = "Мой трекер задач";
}

<div class="container mt-4" style="max-width: 750px;">
    <h1 class="mb-4 text-center">📝 Трекер задач</h1>

    <!-- Форма добавления новой задачи -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <form method="post">
                <div class="row g-2">
                    <div class="col-md-5">
                        <input asp-for="NewTask.Title" class="form-control" placeholder="Что нужно сделать? *" required />
                    </div>
                    <div class="col-md-4">
                        <input asp-for="NewTask.Description" class="form-control" placeholder="Описание (необязательно)" />
                    </div>
                    <div class="col-md-3">
                        <input asp-for="NewTask.DueDate" type="date" class="form-control" />
                    </div>
                </div>
                <button type="submit" class="btn btn-primary mt-3 w-100">Добавить задачу</button>
            </form>
        </div>
    </div>

    <!-- Панель фильтрации и поиска (работает через method="get") -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <!-- Кнопки фильтров -->
        <div class="btn-group" role="group">
            <a asp-page="Index" asp-route-Filter="all" asp-route-SearchTerm="@Model.SearchTerm"
               class="btn btn-sm @(Model.Filter == "all" ? "btn-dark" : "btn-outline-dark")">
                Все
            </a>
            <a asp-page="Index" asp-route-Filter="active" asp-route-SearchTerm="@Model.SearchTerm"
               class="btn btn-sm @(Model.Filter == "active" ? "btn-dark" : "btn-outline-dark")">
                Активные
            </a>
            <a asp-page="Index" asp-route-Filter="completed" asp-route-SearchTerm="@Model.SearchTerm"
               class="btn btn-sm @(Model.Filter == "completed" ? "btn-dark" : "btn-outline-dark")">
                Выполненные
            </a>
        </div>

        <!-- Форма поиска -->
        <form method="get" class="d-flex gap-2">
            <!-- Сохраняем текущий выбранный фильтр при поиске -->
            <input type="hidden" name="Filter" value="@Model.Filter" />
            <input asp-for="SearchTerm" class="form-control form-control-sm" placeholder="Поиск задач..." />
            <button type="submit" class="btn btn-sm btn-outline-primary">Найти</button>
            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
            {
                <a asp-page="Index" asp-route-Filter="@Model.Filter" class="btn btn-sm btn-outline-secondary">✕</a>
            }
        </form>
    </div>

    <!-- Список задач -->
    @if (Model.TodoList.Count == 0)
    {
        <div class="alert alert-info text-center">
            Задачи не найдены. Попробуйте изменить фильтр или добавьте новую задачу!
        </div>
    }
    else
    {
        <ul class="list-group shadow-sm">
            @foreach (var item in Model.TodoList)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center @(item.IsCompleted ? "bg-light text-muted" : "")">
                    <div>
                        <h5 class="mb-1 @(item.IsCompleted ? "text-decoration-line-through" : "")">
                            @item.Title
                        </h5>
                        @if (!string.IsNullOrEmpty(item.Description))
                        {
                            <p class="mb-1 small">@item.Description</p>
                        }
                        @if (item.DueDate.HasValue)
                        {
                            <small class="text-secondary">📅 Срок: @item.DueDate.Value.ToString("dd.MM.yyyy")</small>
                        }
                    </div>

                    <div class="d-flex gap-2">
                        <!-- Кнопка смены статуса -->
                        <form method="post" asp-page-handler="Toggle" asp-route-id="@item.Id"
                              asp-route-Filter="@Model.Filter" asp-route-SearchTerm="@Model.SearchTerm">
                            <button type="submit" class="btn btn-sm @(item.IsCompleted ? "btn-outline-secondary" : "btn-outline-success")">
                                @(item.IsCompleted ? "↩ Вернуть" : "✔ Готово")
                            </button>
                        </form>

                        <!-- Кнопка редактирования -->
                        <a asp-page="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">✏️</a>

                        <!-- Кнопка удаления -->
                        <form method="post" asp-page-handler="Delete" asp-route-id="@item.Id"
                              asp-route-Filter="@Model.Filter" asp-route-SearchTerm="@Model.SearchTerm">
                            <button type="submit" class="btn btn-sm btn-outline-danger">🗑</button>
                        </form>
                    </div>
                </li>
            }
        </ul>
    }
</div>