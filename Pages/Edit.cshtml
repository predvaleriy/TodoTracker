@page "{id:int}"
@model EditModel
@{
    ViewData["Title"] = "Редактировать задачу";
}

<div class="container mt-4" style="max-width: 600px;">
    <h2 class="mb-4">✏️ Редактирование задачи</h2>

    <div class="card shadow-sm">
        <div class="card-body">
            <form method="post">
                <!-- Скрытое поле для передачи Id задачи обратно на сервер при сохранении -->
                <input type="hidden" asp-for="TaskItem.Id" />

                <div class="mb-3">
                    <label class="form-label">Название задачи *</label>
                    <input asp-for="TaskItem.Title" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label class="form-label">Описание</label>
                    <textarea asp-for="TaskItem.Description" class="form-control" rows="3"></textarea>
                </div>

                <div class="mb-3">
                    <label class="form-label">Срок выполнения</label>
                    <input asp-for="TaskItem.DueDate" type="date" class="form-control" />
                </div>

                <div class="form-check mb-4">
                    <input asp-for="TaskItem.IsCompleted" class="form-check-input" type="checkbox" />
                    <label class="form-check-label" asp-for="TaskItem.IsCompleted">
                        Задача выполнена
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Сохранить изменения</button>
                    <a asp-page="Index" class="btn btn-outline-secondary">Отмена</a>
                </div>
            </form>
        </div>
    </div>
</div>